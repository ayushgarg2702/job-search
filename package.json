{
  "name": "career-os",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @career-os/web dev",
    "build": "pnpm --filter @career-os/web build",
    "start": "pnpm --filter @career-os/web start",
    "lint": "pnpm --filter @career-os/web lint",
    "typecheck": "pnpm -r typecheck",
    "worker:jobspy": "cd workers/jobspy && ./run.sh",
    "worker:browser": "pnpm --filter @career-os/browser-worker start",
    "browser:install": "pnpm --filter @career-os/browser-worker exec playwright install chromium"
  }
}
